+// Static is drawn from a small noise image and scaled up: cheap to
+// regenerate every frame, and it still looks like analogue TV static.
+constexpr int NOISE_WIDTH = 320;
+constexpr int NOISE_HEIGHT = 180;
+constexpr int STATIC_FRAME_MS = 50;      // 20fps
+constexpr int STATIC_DURATION_MS = 2000; // exactly ~2 seconds per spec
