+void SmartTvRemote::flashChannelUp()
+{
+    // Glow colour follows the current theme accent, so the remote glow
+    // follows the auto holiday theme (gold in January, pink in February,
+    // orange in October, ...).
+    this->channelUpButton_->setStyleSheet(
+        channelUpStyle(getTheme()->accent));
+    this->updateChannelLabel();
+    QTimer::singleShot(CHANNEL_UP_GLOW_MS, this,
+                       [this] { this->restoreChannelUpStyle(); });
+}
