+               "QPushButton { background-color: %1; color: #ffffff; "
+               "border: 3px solid #ffffff; border-radius: 10px; "
+               "font-size: 22px; font-weight: bold; padding: 6px 18px; }")
+        .arg(glow.name());
+}
