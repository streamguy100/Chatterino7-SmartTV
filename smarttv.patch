+void Theme::checkSmartTvHolidayTheme()
+{
+    QString current = this->themeName.getValue();
+    // Only auto-swap inside the Smart TV family. If the user picked
+    // Dark, Light, or any other theme, leave their choice alone.
+    if (!current.startsWith(QStringLiteral("SmartTV")))
+    {
+        return;
+    }
+    QString wanted = smartTvHolidayThemeKey(QDate::currentDate());
+    if (wanted != current)
+    {
+        // Triggers the themeName listener -> update(), no recursion:
+        // update() never calls back into this check.
+        this->themeName.setValue(wanted);
+    }
+}
+
+void Theme::scheduleSmartTvHolidayCheck()
+{
+    // Fire exactly at the next month boundary (local PC time), then
+    // re-arm. No polling, no wakeups in between.
+    QDateTime now = QDateTime::currentDateTime();
+    // 1st of next month, local PC time (Dec rolls to Jan next year).
+    QDate firstOfNextMonth =
+        QDate(now.date().year(), now.date().month(), 1).addMonths(1);
+    QDateTime boundary(firstOfNextMonth, QTime(0, 0, 0));
+    qint64 msUntil = now.msecsTo(boundary);
+    if (msUntil < 0)
+    {
+        msUntil = 0;
+    }
+    QTimer::singleShot(static_cast<int>(msUntil), &this->lifetime_, [this] {
+        this->checkSmartTvHolidayTheme();
+        this->scheduleSmartTvHolidayCheck();
+    });
+}
