+// --- Smart TV auto holiday theme ---------------------------------------
+// One primary holiday per month (USA), whole month = that holiday's look.
+// August has no holiday: the default Smart TV theme. Easter is computed
+// with the Gregorian computus, so in Easter-in-March years March is
+// Easter and April falls back to the default theme.
+//
+// Test/preview hook (no settings UI): set the environment variable
+// CHATTERINO_SMARTTV_HOLIDAY_MONTH=1..12 before launching and the app
+// previews that month (current year is used for the Easter computus).
+
+/// Month (3 = March, 4 = April) Easter falls in for the given year.
+/// Anonymous Gregorian computus. Verified: 2024 -> Mar 31, 2026 -> Apr 5,
+// 2027 -> Mar 28.
+int easterMonthForYear(int year)
+{
+    int a = year % 19;
+    int b = year / 100;
+    int c = year % 100;
+    int d = b / 4;
+    int e = b % 4;
+    int f = (b + 8) / 25;
+    int g = (b - f + 1) / 3;
+    int h = (19 * a + b - d - g + 15) % 30;
+    int i = c / 4;
+    int k = c % 4;
+    int l = (32 + 2 * e + 2 * i - h - k) % 7;
+    int m = (a + 11 * h + 22 * l) / 451;
+    return (h + l - 7 * m + 114) / 31;
+}
+
+QString smartTvHolidayThemeKey(const QDate &date)
+{
+    int month = date.month();
+    int year = date.year();
+
+    // Preview hook: CHATTERINO_SMARTTV_HOLIDAY_MONTH=1..12
+    bool ok = false;
+    int previewMonth =
+        qEnvironmentVariable("CHATTERINO_SMARTTV_HOLIDAY_MONTH").toInt(&ok);
+    if (ok && previewMonth >= 1 && previewMonth <= 12)
+    {
+        month = previewMonth;
+    }
+
+    // Easter wins over the fixed holiday of its month.
+    if (month == easterMonthForYear(year))
+    {
+        return QStringLiteral("SmartTV-Easter");
+    }
+
+    switch (month)
+    {
+        case 1:
+            return QStringLiteral("SmartTV-NewYears");
+        case 2:
+            return QStringLiteral("SmartTV-Valentines");
+        case 3:
+            return QStringLiteral("SmartTV-StPatricks");
+        case 5:
+            return QStringLiteral("SmartTV-Memorial");
+        case 6:
+            return QStringLiteral("SmartTV-Juneteenth");
+        case 7:
+            return QStringLiteral("SmartTV-Independence");
+        case 9:
+            return QStringLiteral("SmartTV-Labor");
+        case 10:
+            return QStringLiteral("SmartTV-Halloween");
+        case 11:
+            return QStringLiteral("SmartTV-Thanksgiving");
+        case 12:
+            return QStringLiteral("SmartTV-Christmas");
+        case 4:  // April: Easter, or default when Easter was in March
+        case 8:  // August: no holiday
+        default:
+            return QStringLiteral("SmartTV");
+    }
+}
