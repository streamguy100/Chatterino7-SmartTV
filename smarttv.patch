+    // Plain black TV screen. Text only, no emoji - a TV boot logo
+    // must render in any font, and emoji fallback is not guaranteed.
+    this->setStyleSheet("background-color: #000000;");
+    this->hide();
+
+    auto *layout = new QVBoxLayout(this);
+    layout->setContentsMargins(20, 20, 20, 20);
+    layout->setSpacing(12);
+    layout->addStretch();
+
+    auto *logoLabel = new QLabel(QStringLiteral("SMART TV"), this);
+    logoLabel->setAlignment(Qt::AlignCenter);
+    logoLabel->setStyleSheet(
+        "color: #ffffff; font-size: 56px; font-weight: bold;");
+    layout->addWidget(logoLabel);
+
+    auto *subLabel = new QLabel(QStringLiteral("CHATTERINO7 TV"), this);
+    subLabel->setAlignment(Qt::AlignCenter);
+    subLabel->setStyleSheet(
+        "color: #e62117; font-size: 22px; font-weight: bold;");
+    layout->addWidget(subLabel);
+
+    this->progressBar_ = new QProgressBar(this);
+    this->progressBar_->setRange(0, 100);
+    this->progressBar_->setValue(0);
+    this->progressBar_->setTextVisible(false);
+    this->progressBar_->setFixedSize(420, 14);
+    this->progressBar_->setStyleSheet(
+        "QProgressBar { background-color: #222222; border: none; "
+        "border-radius: 7px; }"
+        "QProgressBar::chunk { background-color: #e62117; "
+        "border-radius: 7px; }");
+    layout->addWidget(this->progressBar_, 0, Qt::AlignCenter);
+
+    auto *loadingLabel =
+        new QLabel(QStringLiteral("Loading channels..."), this);
+    loadingLabel->setAlignment(Qt::AlignCenter);
+    loadingLabel->setStyleSheet("color: #aaaaaa; font-size: 16px;");
+    layout->addWidget(loadingLabel);
+
+    layout->addStretch();
+
+    // Drives the loading bar and keeps the splash covering the whole
+    // window if it is resized during the boot.
+    QObject::connect(&this->frameTimer_, &QTimer::timeout, this, [this] {
+        if (this->parentWidget() != nullptr)
+        {
+            this->setGeometry(this->parentWidget()->rect());
+            this->raise();
+        }
+        this->progress_ =
+            std::min(100, this->progress_ +
+                              100 * BOOT_FRAME_MS / BOOT_HOLD_MS);
+        this->progressBar_->setValue(this->progress_);
+    });
+    this->frameTimer_.setInterval(BOOT_FRAME_MS);
+}
+
+void SmartTvBootScreen::showBootScreen()
+{
+    if (this->parentWidget() != nullptr)
+    {
+        this->setGeometry(this->parentWidget()->rect());
+    }
+    this->progress_ = 0;
+    this->progressBar_->setValue(0);
+    this->fading_ = false;
+    this->raise();
+    this->show();
+    this->frameTimer_.start();
+    // The fallback timeout: fires no matter what, so the splash can
+    // never stick on loading even if chats are slow to connect.
+    // Chats load underneath the whole time - nothing waits on them.
+    QTimer::singleShot(BOOT_HOLD_MS, this, [this] {
+        this->beginFadeOut();
+    });
+}
+
+void SmartTvBootScreen::beginFadeOut()
+{
+    if (this->fading_)
+    {
+        return;
+    }
+    this->fading_ = true;
+    this->frameTimer_.stop();
+
+    auto *effect = new QGraphicsOpacityEffect(this);
+    this->setGraphicsEffect(effect);
+    auto *animation = new QPropertyAnimation(effect, "opacity", this);
+    animation->setDuration(BOOT_FADE_MS);
+    animation->setStartValue(1.0);
+    animation->setEndValue(0.0);
+    QObject::connect(animation, &QPropertyAnimation::finished, this,
+                     [this] { this->hide(); });
+    animation->start(QAbstractAnimation::DeleteWhenStopped);
+}
+
+}  // namespace chatterino
