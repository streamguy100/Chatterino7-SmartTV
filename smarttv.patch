+SmartTvStaticOverlay::SmartTvStaticOverlay(QWidget *parent)
+    : QWidget(parent)
+    , noise_(NOISE_WIDTH, NOISE_HEIGHT, QImage::Format_RGB32)
+{
+    // Never eat mouse clicks: the user can keep switching tabs while
+    // static is showing, and each switch just restarts the 2s timer.
+    this->setAttribute(Qt::WA_TransparentForMouseEvents, true);
+    this->hide();
+
+    this->frameTimer_.setInterval(STATIC_FRAME_MS);
+    QObject::connect(&this->frameTimer_, &QTimer::timeout, this, [this] {
+        this->regenerateNoise();
+        this->update();
+    });
+
+    this->hideTimer_.setSingleShot(true);
+    QObject::connect(&this->hideTimer_, &QTimer::timeout, this, [this] {
+        this->frameTimer_.stop();
+        this->hide();
+    });
+}
+
+void SmartTvStaticOverlay::showStatic()
+{
+    if (this->parentWidget() == nullptr)
+    {
+        return;
+    }
+    this->setGeometry(this->parentWidget()->rect());
+    this->raise();
+    this->regenerateNoise();
+    this->show();
+    this->frameTimer_.start();
+    // Restartable: a tab change during static restarts the full 2s.
+    this->hideTimer_.start(STATIC_DURATION_MS);
+}
+
+void SmartTvStaticOverlay::regenerateNoise()
+{
+    auto *bits = reinterpret_cast<QRgb *>(this->noise_.bits());
+    const int count = NOISE_WIDTH * NOISE_HEIGHT;
+    for (int i = 0; i < count; ++i)
+    {
+        int grey = QRandomGenerator::global()->bounded(256);
+        bits[i] = qRgb(grey, grey, grey);
+    }
+}
+
+void SmartTvStaticOverlay::paintEvent(QPaintEvent * /*event*/)
+{
+    QPainter painter(this);
+    painter.drawImage(this->rect(), this->noise_);
+}
