+// SPDX-FileCopyrightText: 2026 Contributors to Chatterino <https://chatterino.com>
+//
+// SPDX-License-Identifier: MIT
+
+#pragma once
+
+#include <QImage>
+#include <QLabel>
+#include <QProgressBar>
+#include <QPushButton>
+#include <QTimer>
+#include <QWidget>
+
+namespace chatterino {
+
+class Notebook;
+
+/**
+ * Smart TV remote bar, shown at the bottom of the main window.
+ *
+ * CH+ / CH- switch tabs exactly like the notebook does (next / previous
+ * visible tab). The power button minimises the window. The channel label
+ * shows the currently selected tab number.
+ *
+ * flashChannelUp() lights the CH+ button up in the current theme accent
+ * colour (so it follows the auto holiday theme) for a short moment.
+ * It is called on every tab change, however the tab was changed.
+ */
+class SmartTvRemote : public QWidget
+{
+    Q_OBJECT
+
+public:
+    SmartTvRemote(Notebook *notebook, QWidget *parent);
+
+    void flashChannelUp();
+    void updateChannelLabel();
+
+private:
+    void restoreChannelUpStyle();
+
+    Notebook *notebook_;
+    QPushButton *channelUpButton_;
+    QPushButton *channelDownButton_;
+    QLabel *channelLabel_;
+};
+
+/**
+ * Animated TV static overlay, shown over the chat area for ~2 seconds
+ * on every tab change.
+ *
+ * The noise is generated live (a small random image, repainted at 20fps
+ * and scaled up), never a still image. It is transparent to mouse events,
+ * so it can never block a click or a further tab switch, and it hides
+ * itself on a timer - it cannot freeze the app.
+ */
+class SmartTvStaticOverlay : public QWidget
+{
+    Q_OBJECT
+
+public:
+    explicit SmartTvStaticOverlay(QWidget *parent);
+
+    /// Show static over the whole parent for ~2 seconds. Restartable:
+    /// calling it again while visible restarts the 2 second timer.
+    void showStatic();
+
+protected:
+    void paintEvent(QPaintEvent *event) override;
+
+private:
+    void regenerateNoise();
+
+    QTimer frameTimer_;
+    QTimer hideTimer_;
+    QImage noise_;
+};
+
+/**
+ * TV boot loading screen, shown on EVERY launch of the main window,
+ * like a real TV being turned on: black screen, SMART TV /
+ * Chatterino7 TV logo, loading bar, then a fade into the chats.
+ *
+ * It never blocks loading: the chats load underneath while the splash
+ * shows (the splash is only a visual cover), and a fixed timer hides
+ * it after ~2.5 s + a short fade no matter what - it can never stick
+ * on loading even if chats are slow to connect.
+ */
+class SmartTvBootScreen : public QWidget
+{
+    Q_OBJECT
+
+public:
+    explicit SmartTvBootScreen(QWidget *parent);
+
+    /// Show the splash and start the boot timer. Safe to call once,
+    /// at window construction - the splash appears when the window does.
+    void showBootScreen();
+
+private:
+    void beginFadeOut();
+
+    QTimer frameTimer_;
+    QProgressBar *progressBar_;
+    int progress_ = 0;
+    bool fading_ = false;
+};
+
+}  // namespace chatterino
